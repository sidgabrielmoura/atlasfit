  studentMemberId String
  studentUserId   String
  enrollmentId    String?
  billingId       String?
  invoiceNumber   String           @unique
  title           String
  description     String?          @db.Text
  status          GymInvoiceStatus @default(OPEN)
  dueDate         DateTime
  issueDate       DateTime         @default(now())
  competenceMonth String?
  recurrenceKey   String?          @unique
  issuanceKey     String?          @unique
  issuanceFingerprint String?

  subtotalInCents         BigInt
  discountInCents         BigInt @default(0)
  totalInCents            BigInt
  paidAmountInCents       BigInt @default(0)
  openingPaidAmountInCents BigInt @default(0)
